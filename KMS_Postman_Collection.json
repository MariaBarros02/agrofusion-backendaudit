							"query": [
								{"key": "limit", "value": "50"},
								{"key": "offset", "value": "0"}
							]
						},
						"description": "RF-INT-19: eventos de af_audit_log relacionados con la firma: su creación, validaciones y eventos del ciclo de vida de la clave/certificado subyacentes."
					},
					"response": []
				},
				{
					"name": "9. Eventos KMS en Auditoría - RF-INT-19",
					"request": {
						"method": "GET",
						"header": [
