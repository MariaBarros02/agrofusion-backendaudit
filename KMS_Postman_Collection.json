								{"key": "date_to", "value": "", "disabled": true},
								{"key": "actor_id", "value": "", "disabled": true}
							]
						},
						"description": "RF-INT-19: consulta paginada de eventos de auditoría del módulo KMS. Soporta filtrar por action_code (KMS_CA_CREATED, KMS_KEY_CREATED, KMS_KEY_ROTATED, KMS_KEY_REVOKED, KMS_CERT_CREATED, KMS_CERT_REVOKED, KMS_CERT_VALIDATED, SIGNATURE_CREATED, SIGNATURE_VALIDATED), rango de fechas y usuario."
					},
					"response": []
				}
			],
			"description": "Endpoints para firma y validación de documentos"
